---
import ExperienceItem from "./ExperienceItem.astro"
const EXPERIENCIE = [
  {
    date: "Febrero 2024 - Julio 2024",
    title: "Desarrollador Fullstack",
    company: "Grupo MAPER",
    description:
      "Durante mi residencia profesional, desarrollé una aplicación web para la Escuela Secundaria Técnica Industrial No. 97 como parte del sistema SISADESC, mejorando la comunicación entre padres y la institución. Diseñé e implementé una interfaz eficiente para acceder a calificaciones, asistencia y eventos, asegurando que la plataforma fuera accesible y responsiva en diferentes dispositivos.",
  },
  {
    date: "Semptiembre 2023 - Enero 2024",
    title: "Desarrollador Fullstack",
    company: "Ayuntamiento de Teocelo",
    description: "Desarrollé una aplicación web para el Ayuntamiento de Teocelo utilizando ReactJS, Node.js, Express y MongoDB, que digitalizó trámites y mejoró la comunicación con los ciudadanos. La plataforma integró funciones como solicitudes en línea, gestión de trámites y notificaciones, reduciendo en un 50% la necesidad de atención presencial y optimizando los procesos mediante prácticas de desarrollo ágil.",
  }
]
---

<ol class="relative mt-16">
  {
    EXPERIENCIE.map((experiencie) => (
      <li class="">
        <ExperienceItem {...experiencie} />
      </li>
    ))
  }
</ol>
